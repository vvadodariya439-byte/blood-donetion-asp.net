<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="BloodBankSystem.SiteMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blood Bank Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="assets/css/style.css" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Master Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-danger sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href='<%= ResolveUrl("~/index.aspx") %>'>
                    <i class="fas fa-droplet fa-lg" style="color:#ffd700"></i>
                    <div>
                        <div class="brand-text text-white font-weight-bold">LifeFlow</div>
                        <div class="brand-sub text-white-50 small">Blood Bank System</div>
                    </div>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        <li class="nav-item"><a class="nav-link text-white" href='<%= ResolveUrl("~/index.aspx") %>'>Home</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href='<%= ResolveUrl("~/index.aspx#availability") %>'>Blood Stock</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href='<%= ResolveUrl("~/index.aspx#camps") %>'>Blood Camps</a></li>
                        
                        <asp:PlaceHolder ID="phGuest" runat="server">
                            <li class="nav-item ms-lg-3">
                                <a href='<%= ResolveUrl("~/login.aspx") %>' class="btn btn-outline-light btn-sm rounded-pill px-3">Login</a>
                            </li>
                            <li class="nav-item">
                                <a href='<%= ResolveUrl("~/register.aspx") %>' class="btn btn-warning btn-sm rounded-pill px-3 fw-600">Register</a>
                            </li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phUser" runat="server" Visible="false">
                            <li class="nav-item ms-lg-3">
                                <asp:HyperLink ID="lnkDashboard" runat="server" CssClass="btn btn-warning btn-sm rounded-pill px-3 me-2 fw-bold" Text="My Dashboard"></asp:HyperLink>
                            </li>
                            <li class="nav-item">
                                <asp:Label ID="lblMasterUser" runat="server" CssClass="text-white fw-bold me-2"></asp:Label>
                            </li>
                            <li class="nav-item">
                                <asp:LinkButton ID="lnkLogout" runat="server" CssClass="btn btn-outline-light btn-sm rounded-pill px-3" OnClick="lnkLogout_Click">Logout</asp:LinkButton>
                            </li>
                        </asp:PlaceHolder>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content Placeholder -->
        <div class="container-fluid min-vh-100 p-0">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <!-- Master Footer -->
        <footer class="bg-dark text-white py-4 text-center mt-5">
            <p class="mb-0">&copy; 2024 LifeFlow Blood Bank Management System. All Rights Reserved.</p>
        </footer>
    </form>
</body>
</html>
